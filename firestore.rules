rules_version = '2';

// Reglas de seguridad de Taotao.
// Idea principal: todo lo de la pareja vive en couples/{coupleId} y solo
// las dos personas que están en `members` pueden leerlo o escribirlo.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }
    function coupleDoc(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId));
    }
    function coupleAfter(coupleId) {
      return getAfter(/databases/$(database)/documents/couples/$(coupleId));
    }
    function isMember(coupleId) {
      return signedIn() && me() in coupleDoc(coupleId).data.members;
    }
    // Una pareja desvinculada guarda sus recuerdos con `endedAt`.
    function ended(couple) { return couple.get('endedAt', null) != null; }
    function isPartnerOf(uid) {
      let myCouple = userDoc(me()).data.get('coupleId', null);
      return myCouple != null && uid in coupleDoc(myCouple).data.members;
    }

    // ---------- Perfiles ----------
    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || isPartnerOf(uid));

      allow create: if signedIn() && me() == uid
        && request.resource.data.coupleId == null;

      // La propia persona puede editar su perfil. Si cambia coupleId,
      // tiene que ser a null o a un espacio de pareja del que forma parte.
      allow update: if signedIn() && me() == uid
        && request.resource.data.pairCode == resource.data.pairCode
        // Foto de perfil: JPG chiquito en base64 (o 'gatito').
        && (!('foto' in request.resource.data)
            || (request.resource.data.foto is string
                && request.resource.data.foto.size() <= 300000))
        && (
          request.resource.data.coupleId == resource.data.coupleId
          || request.resource.data.coupleId == null
          || uid in coupleAfter(request.resource.data.coupleId).data.members
        );

      // Vincularse: quien ingresa el código marca coupleId en el perfil de
      // la otra persona, solo si esa persona no tiene pareja todavía y en el
      // mismo batch se está creando el espacio de pareja con los dos.
      allow update: if signedIn() && me() != uid
        && resource.data.coupleId == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['coupleId'])
        && !exists(/databases/$(database)/documents/couples/$(request.resource.data.coupleId))
        && coupleAfter(request.resource.data.coupleId).data.members.hasAll([me(), uid]);

      // Volver a vincularse con la misma persona: se reabre el espacio de
      // pareja que tenían (con sus notas, cartas, etc.).
      allow update: if signedIn() && me() != uid
        && resource.data.coupleId == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['coupleId'])
        && ended(coupleDoc(request.resource.data.coupleId).data)
        && !ended(coupleAfter(request.resource.data.coupleId).data)
        && coupleAfter(request.resource.data.coupleId).data.members.hasAll([me(), uid]);

      // Desvincularse: quien termina la pareja también quita el coupleId de
      // la otra persona, en el mismo batch en que marca la pareja con endedAt.
      allow update: if signedIn() && me() != uid
        && resource.data.coupleId != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['coupleId'])
        && request.resource.data.coupleId == null
        && me() in coupleDoc(resource.data.coupleId).data.members
        && ended(coupleAfter(resource.data.coupleId).data);

      // Notas privadas: solo su dueño.
      match /privateNotes/{noteId} {
        allow read, write: if signedIn() && me() == uid;
      }

      // Tareas del pomodoro: solo su dueño.
      match /pomodoroTasks/{taskId} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    // ---------- Códigos de pareja ----------
    match /pairCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update, delete: if false;
    }

    // ---------- Espacio de pareja ----------
    match /couples/{coupleId} {
      allow read: if signedIn() && me() in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && getAfter(/databases/$(database)/documents/users/$(me())).data.coupleId == coupleId;

      // Mientras está activa, cualquiera de los dos la edita (también para
      // desvincularse, marcando endedAt). Ya desvinculada, solo se puede
      // reabrir, y quien la reabre vuelve a apuntar a ella en el mismo batch.
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.members == resource.data.members
        && (
          (!ended(resource.data)
            && (!ended(request.resource.data)
                || request.resource.data.endedBy == me()))
          || (!ended(request.resource.data)
            && getAfter(/databases/$(database)/documents/users/$(me())).data.coupleId == coupleId)
        );

      allow delete: if false;

      // Ánimo: cada uno escribe solo el suyo.
      match /moods/{uid} {
        allow read: if isMember(coupleId);
        allow write: if isMember(coupleId) && me() == uid;
      }

      // Notas compartidas: las leen los dos, cada uno edita las suyas.
      match /notes/{noteId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.authorId == me();
        allow update, delete: if isMember(coupleId)
          && resource.data.authorId == me();
        // Los dos pueden marcar o quitar los pendientes de una nota con lista.
        allow update: if isMember(coupleId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['items']);
        // Quien recibe una nota privada compartida la marca como leída
        // (una vez, con la hora del servidor), para que su pareja lo sepa.
        allow update: if isMember(coupleId)
          && resource.data.authorId != me()
          && resource.data.get('fromPrivate', false) == true
          && resource.data.get('leidaEn', null) == null
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['leidaEn', 'leidaPor'])
          && request.resource.data.leidaPor == me()
          && request.resource.data.leidaEn == request.time;
      }

      // Cartas "Ábrelo cuando…": cada uno escribe para su pareja. Quien la
      // recibe solo puede marcarla como abierta; quien la escribió, borrarla.
      match /letters/{letterId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.from == me()
          && request.resource.data.to != me()
          && request.resource.data.to in coupleDoc(coupleId).data.members
          && request.resource.data.openedAt == null
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.cuando is string
          && request.resource.data.cuando.size() > 0
          && request.resource.data.cuando.size() <= 60
          // Carta de cumpleaños o aniversario, con su pastel.
          && request.resource.data.get('especial', null) in [null, 'cumple', 'aniversario']
          && request.resource.data.get('pastel', null)
               in [null, 'fresa', 'chocolate', 'gatito', 'corazon']
          && request.resource.data.get('ramo', null)
               in [null, 'rojo', 'rosa', 'amarillo', 'lila', 'blanco', 'celeste', 'mixto']
          && request.resource.data.get('regalitos', []) is list
          && request.resource.data.get('regalitos', []).size() <= 5
          && request.resource.data.get('regalitos', [])
               .hasOnly(['peluche', 'chocolates', 'globos', 'cajita', 'taza'])
          // Foto (JPG en base64, sin Storage), enlace y stickers pegados.
          && (request.resource.data.get('foto', null) == null
              || (request.resource.data.foto is string
                  && request.resource.data.foto.size() <= 750000))
          && (request.resource.data.get('enlace', null) == null
              || (request.resource.data.enlace is string
                  && request.resource.data.enlace.size() <= 500
                  && request.resource.data.enlace.matches('https?://.+')))
          && request.resource.data.get('stickers', []) is list
          && request.resource.data.get('stickers', []).size() <= 5
          // Carta guardada para una fiesta: se abre ese día.
          && request.resource.data.get('fiesta', null)
               in [null, 'anioNuevo', 'sanValentin', 'anioNuevoChino', 'qixi', 'navidad']
          && (request.resource.data.get('fiesta', null) == null
              ? (request.resource.data.get('abrirEl', null) == null
                  && request.resource.data.get('avisarEn', null) == null)
              : (request.resource.data.fiestaDia is string
                  && request.resource.data.fiestaDia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                  && request.resource.data.abrirEl is timestamp
                  && request.resource.data.abrirEl < request.time + duration.value(400, 'd')
                  && (request.resource.data.get('avisarEn', null) == null
                      || request.resource.data.avisarEn is timestamp)))
          // Una carta sorpresa se paga con pescaditos en el mismo momento.
          && (request.resource.data.get('sorpresa', false) == false
              || (request.resource.data.sorpresa == true
                  && existsAfter(/databases/$(database)/documents/couples/$(coupleId)/casitaMovs/$('carta_' + letterId))));
        // Quien la recibe la marca abierta (una carta de fiesta, solo desde
        // su día: se dan 26 h de margen por si viven en otro huso horario),
        // o pone el aviso de la fiesta a la hora de su teléfono.
        allow update: if isMember(coupleId)
          && me() == resource.data.to
          && resource.data.openedAt == null
          && ((request.resource.data.openedAt is timestamp
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['openedAt'])
              && (resource.data.get('abrirEl', null) == null
                  || request.time > resource.data.abrirEl - duration.value(26, 'h')))
            || (resource.data.get('avisarEn', null) != null
              && request.resource.data.avisarEn is timestamp
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['avisarEn'])
              && request.resource.data.avisarEn > resource.data.abrirEl - duration.value(26, 'h')
              && request.resource.data.avisarEn < resource.data.abrirEl + duration.value(36, 'h')));
        allow delete: if isMember(coupleId) && me() == resource.data.from;
      }

      // Pomodoro en pareja: uno invita, solo la otra persona puede aceptar.
      match /pomodoros/{sessionId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.invitedBy == me()
          && request.resource.data.invitee != me()
          && request.resource.data.invitee in coupleDoc(coupleId).data.members
          && request.resource.data.status == 'pending'
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 5
          && request.resource.data.minutes <= 60
          && request.resource.data.get('startedAt', null) == null;
        // Al aceptar, la persona invitada puede confirmar, bajar o subir la
        // duración. Después nadie puede cambiar la duración ni la hora de
        // inicio: de eso depende que la sesión juntos dé premio. Una sesión
        // cancelada (alguien se salió) o terminada ya no cambia más.
        allow update: if isMember(coupleId)
          && request.resource.data.invitedBy == resource.data.invitedBy
          && request.resource.data.invitee == resource.data.invitee
          && (
            (resource.data.status == 'pending'
              && me() == resource.data.invitee
              && request.resource.data.status == 'accepted'
              && request.resource.data.startedAt == request.time
              && request.resource.data.minutes is int
              && request.resource.data.minutes >= 5
              && request.resource.data.minutes <= 60)
            || (resource.data.status == 'pending'
              && me() == resource.data.invitee
              && request.resource.data.status == 'declined'
              && request.resource.data.minutes == resource.data.minutes
              && request.resource.data.get('startedAt', null) == null)
            || (request.resource.data.status == 'cancelled'
              && resource.data.status in ['pending', 'accepted']
              && request.resource.data.minutes == resource.data.minutes
              && request.resource.data.get('startedAt', null) == resource.data.get('startedAt', null))
            || (request.resource.data.status == 'finished'
              && resource.data.status == 'accepted'
              && request.resource.data.minutes == resource.data.minutes
              && request.resource.data.startedAt == resource.data.startedAt)
          );
      }

      // Premios: cada uno arma y edita su propia lista. En la app, la lista
      // de la pareja se muestra recién al terminar una sesión.
      match /rewards/{rewardId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.createdBy == me()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80;
        allow update: if isMember(coupleId)
          && resource.data.createdBy == me()
          && request.resource.data.createdBy == me()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80;
        allow delete: if isMember(coupleId) && resource.data.createdBy == me();
      }

      // Logros (pomodoro o tarea cumplida) y el premio elegido.
      // Cada uno crea los suyos y elige su premio; la pareja solo puede
      // marcar que ya lo entregó. Solo se elige UN premio por logro: nace
      // sin premio, se elige una vez y después ya no se puede cambiar.
      match /achievements/{achievementId} {
        // Un pomodoro en pareja solo da logro si la sesión no se canceló
        // (nadie se salió) y ya pasó su tiempo completo.
        function sessionDone(sid) {
          let s = get(/databases/$(database)/documents/couples/$(coupleId)/pomodoros/$(sid)).data;
          return me() in [s.invitedBy, s.invitee]
            && s.status in ['accepted', 'finished']
            && s.startedAt is timestamp
            && request.time > s.startedAt + duration.value(s.minutes * 60 - 10, 's');
        }
        // Una carta sorpresa animada: 30 pescaditos por carta, y la carta
        // (de esta persona, marcada como sorpresa) se crea a la vez.
        function carta(d) {
          let c = getAfter(/databases/$(database)/documents/couples/$(coupleId)/letters/$(d.ref));
          return d.tipo == 'carta'
            && d.ref is string
            && movId == 'carta_' + d.ref
            && d.cantidad == -30
            && c.data.from == me()
            && c.data.get('sorpresa', false) == true;
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.uid == me()
          && (request.resource.data.get('sessionId', null) == null
            || (request.resource.data.kind == 'pomodoro'
              && achievementId == request.resource.data.sessionId + '_' + me()
              && sessionDone(request.resource.data.sessionId)))
          && request.resource.data.kind in ['pomodoro', 'tarea', 'racha', 'preguntas']
          // Premio de racha (de pareja o de la pregunta del día): uno por
          // meta (7, 30, 60…) y por racha.
          && (!(request.resource.data.kind in ['racha', 'preguntas'])
            || (request.resource.data.meta is int
              && (request.resource.data.meta == 7
                || (request.resource.data.meta > 0
                  && request.resource.data.meta % 30 == 0))
              && request.resource.data.inicio is string
              && request.resource.data.inicio.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && achievementId == request.resource.data.kind + string(request.resource.data.meta)
                   + '_' + request.resource.data.inicio + '_' + me()))
          && request.resource.data.delivered == false
          && request.resource.data.get('rewardId', null) == null
          && request.resource.data.get('rewardTitle', null) == null;
        allow update: if isMember(coupleId)
          && request.resource.data.uid == resource.data.uid
          && (
            // Elegir el premio: solo el dueño, solo si aún no tenía uno,
            // y tiene que ser un premio de la lista de la pareja.
            (me() == resource.data.uid
              && resource.data.delivered == false
              && resource.data.get('rewardId', null) == null
              && request.resource.data.rewardId is string
              && exists(/databases/$(database)/documents/couples/$(coupleId)/rewards/$(request.resource.data.rewardId))
              && request.resource.data.rewardTitle is string
              && request.resource.data.rewardTitle.size() > 0
              && request.resource.data.rewardTitle.size() <= 80
              && request.resource.data.rewardChosenAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['rewardId', 'rewardTitle', 'rewardChosenAt']))
            // Entregarlo: solo la pareja, y solo si ya hay premio elegido.
            || (me() != resource.data.uid
              && resource.data.get('rewardId', null) != null
              && request.resource.data.delivered == true
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['delivered']))
          );
        allow delete: if isMember(coupleId) && me() == resource.data.uid;
      }

      // Pregunta del día: cada uno solo escribe su propia respuesta.
      match /dailyAnswers/{day} {
        function previousAnswers() {
          return resource == null ? {} : resource.data.get('answers', {});
        }
        // Naipe que salió hoy: se elige una vez y ya no cambia.
        function previousCard() {
          return resource == null ? null : resource.data.get('carta', null);
        }
        function keepsCard() {
          return previousCard() == null
            || (request.resource.data.get('carta', null) == previousCard()
                && request.resource.data.get('question', null)
                     == resource.data.get('question', null));
        }
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId)
          && request.resource.data.get('answers', {}).diff(previousAnswers())
               .affectedKeys().hasOnly([me()])
          && keepsCard();
      }

      // Preguntas propias para el mazo de la pregunta del día. Cada uno
      // escribe, edita o borra las suyas; cualquiera de los dos la marca
      // como usada (una sola vez) el día que sale.
      match /preguntas/{preguntaId} {
        function textoValido(t) {
          return t is string && t.size() > 0 && t.size() <= 200;
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys()
               .hasOnly(['texto', 'autor', 'createdAt', 'usadaEn'])
          && request.resource.data.autor == me()
          && textoValido(request.resource.data.texto)
          && request.resource.data.get('usadaEn', null) == null;
        allow update: if isMember(coupleId)
          && resource.data.get('usadaEn', null) == null
          && (
            (resource.data.autor == me()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['texto'])
              && textoValido(request.resource.data.texto))
            || (request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['usadaEn'])
              && request.resource.data.usadaEn is string
              && request.resource.data.usadaEn
                   .matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          );
        allow delete: if isMember(coupleId) && resource.data.autor == me();
      }

      // Datos curiosos: cada uno escribe los suyos, los dos los leen.
      match /datosCuriosos/{datoId} {
        function datoValido(t) {
          return t is string && t.size() > 0 && t.size() <= 300;
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys()
               .hasOnly(['texto', 'autor', 'createdAt'])
          && request.resource.data.autor == me()
          && datoValido(request.resource.data.texto);
        allow update: if isMember(coupleId)
          && resource.data.autor == me()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['texto'])
          && datoValido(request.resource.data.texto);
        allow delete: if isMember(coupleId) && resource.data.autor == me();
      }

      // Racha de pareja: un doc por día con quién hizo su parte
      // ({hechos: {uid: true}}). Cada uno solo se marca a sí mismo.
      match /racha/{day} {
        function previousHechos() {
          return resource == null ? {} : resource.data.get('hechos', {});
        }
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId)
          && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['hechos'])
          && request.resource.data.hechos.diff(previousHechos())
               .affectedKeys().hasOnly([me()])
          && request.resource.data.hechos[me()] == true;
      }

      // Cosas por hacer juntos. Los dos agregan, marcan y borran; cuando ya
      // lo hicieron, cada uno deja solo su propia reseña.
      match /bucketList/{itemId} {
        function resenasBucketOk() {
          let antes = resource.data.get('resenas', {});
          let rs = request.resource.data.get('resenas', {});
          return !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['resenas'])
            || (rs is map
              && rs.diff(antes).affectedKeys().hasOnly([me()])
              && (!(me() in rs)
                || (rs[me()].keys().hasOnly(['estrellas', 'texto'])
                  && rs[me()].estrellas is int
                  && rs[me()].estrellas >= 1
                  && rs[me()].estrellas <= 5
                  && rs[me()].texto is string
                  && rs[me()].texto.size() <= 500)));
        }
        allow read, delete: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.get('resenas', {}).size() == 0;
        allow update: if isMember(coupleId) && resenasBucketOk();
      }

      // "Te extraño": la app le pide al Worker (worker/) que avise a la pareja.
      match /missYou/{id} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.from == me();
      }

      // Recomendación del día (canción, playlist, película, lugar…): cada uno
      // deja una por día para su pareja, con id {yyyy-MM-dd}_{uid}. Quien la
      // escribe la cambia o la borra; la pareja marca si le gustó, y los dos
      // pueden dejar su reseña (estrellitas y comentario), cada uno la suya.
      match /recomendaciones/{recId} {
        function recValida() {
          let r = request.resource.data;
          return r.keys().hasOnly(['from', 'dia', 'categoria', 'titulo',
                                   'nota', 'link', 'gusto', 'resenas',
                                   'updatedAt'])
            && r.from == me()
            && r.dia is string
            && r.dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && recId == r.dia + '_' + me()
            && r.categoria in ['playlist', 'cancion', 'pelicula', 'serie',
                               'libro', 'lugar', 'restaurante', 'podcast', 'otro']
            && r.titulo is string
            && r.titulo.size() > 0
            && r.titulo.size() <= 120
            && (r.get('nota', null) == null
              || (r.nota is string && r.nota.size() <= 300))
            && (r.get('link', null) == null
              || (r.link is string && r.link.size() <= 500
                  && r.link.matches('https?://.+')));
        }
        function previasResenas() {
          return resource.data.get('resenas', {});
        }
        function miResenaValida() {
          let rs = request.resource.data.get('resenas', {});
          return rs is map
            && rs.diff(previasResenas()).affectedKeys().hasOnly([me()])
            && (!(me() in rs)
              || (rs[me()].keys().hasOnly(['estrellas', 'texto'])
                && rs[me()].estrellas is int
                && rs[me()].estrellas >= 1
                && rs[me()].estrellas <= 5
                && rs[me()].texto is string
                && rs[me()].texto.size() <= 500));
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && recValida()
          && request.resource.data.get('gusto', false) == false
          && request.resource.data.get('resenas', {}).size() == 0;
        // Quien la escribió cambia lo suyo, sin tocar corazón ni reseñas.
        allow update: if isMember(coupleId) && recValida()
          && request.resource.data.get('gusto', false)
               == resource.data.get('gusto', false)
          && request.resource.data.get('resenas', {}) == previasResenas();
        allow update: if isMember(coupleId)
          && resource.data.from != me()
          && request.resource.data.gusto is bool
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['gusto']);
        allow update: if isMember(coupleId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['resenas'])
          && miResenaValida();
        allow delete: if isMember(coupleId) && resource.data.from == me();
      }

      // Música juntos: una sola sala por pareja (musica/sala) con la
      // canción que suena, si está en play, el segundo, la cola, quién está
      // escuchando y la cuenta 3-2-1. La manejan los dos.
      match /musica/{salaId} {
        function previo(campo, porDefecto) {
          return resource == null ? porDefecto : resource.data.get(campo, porDefecto);
        }
        function salaValida() {
          let s = request.resource.data;
          return salaId == 'sala'
            && s.keys().hasOnly(['actual', 'sonando', 'posicion', 'cambiadoEn',
                                 'por', 'cola', 'oyentes', 'cuenta'])
            && s.get('sonando', false) is bool
            && s.get('posicion', 0) is number
            && s.get('cola', []) is list
            && s.get('cola', []).size() <= 100
            && s.get('oyentes', {}) is map
            // Cada uno solo dice si él está escuchando.
            && s.get('oyentes', {}).diff(previo('oyentes', {})).affectedKeys()
                 .hasOnly([me()])
            // El último cambio lo firma quien lo hace.
            && (s.get('por', null) == previo('por', null)
                || s.get('por', null) == me())
            && (s.get('cuenta', null) == null
                || s.cuenta == previo('cuenta', null)
                || (s.cuenta.por == me()
                    && s.cuenta.cancion is string
                    && s.cuenta.cancion.size() <= 300));
        }
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId) && salaValida();
        allow delete: if false;
      }

      // Abrazos que se mandan desde el inicio (el botón, o la tarjeta de
      // cuando la pareja no está bien).
      match /abrazos/{id} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.from == me();
      }

      // Besos que se mandan desde el botón del inicio.
      match /besos/{id} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.from == me();
      }

      // ---------- Juegos de pareja ----------
      // juegos/{id}: una partida de "¿Quién es más probable?" o "Adivina mis
      // respuestas". Quien empieza la crea con sus 5 respuestas; la pareja
      // agrega las suyas una sola vez (y la partida termina). Después, cada
      // uno marca en `cobros` el movimiento de pescaditos que cobró.
      match /juegos/{partidaId} {
        function cincoRespuestas(r) {
          return r is list && r.size() == 5;
        }
        function cambia() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
        function responde() {
          return resource.data.terminada == false
            && !(me() in resource.data.respuestas)
            && cambia().hasOnly(['respuestas', 'terminada', 'terminadaEn'])
            && request.resource.data.respuestas.diff(resource.data.respuestas)
                 .affectedKeys().hasOnly([me()])
            && cincoRespuestas(request.resource.data.respuestas[me()])
            && request.resource.data.terminada == true
            && request.resource.data.terminadaEn == request.time;
        }
        function propiaOk(q) {
          return q is map
            && q.keys().hasOnly(['texto', 'opciones'])
            && q.texto is string && q.texto.size() > 0 && q.texto.size() <= 120
            && (!('opciones' in q)
                || (q.opciones is list && q.opciones.size() >= 2 && q.opciones.size() <= 4));
        }
        function propiasOk(p) {
          return p is map
            && p.keys().hasOnly(['0', '1', '2', '3', '4'])
            && (!('0' in p) || propiaOk(p['0']))
            && (!('1' in p) || propiaOk(p['1']))
            && (!('2' in p) || propiaOk(p['2']))
            && (!('3' in p) || propiaOk(p['3']))
            && (!('4' in p) || propiaOk(p['4']));
        }
        function cobra() {
          let antes = resource.data.get('cobros', {});
          return resource.data.terminada == true
            && me() in resource.data.respuestas
            && !(me() in antes)
            && cambia().hasOnly(['cobros'])
            && request.resource.data.cobros.diff(antes).affectedKeys().hasOnly([me()])
            && request.resource.data.cobros[me()] is string;
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys()
               .hasOnly(['juego', 'preguntas', 'por', 'respuestas', 'terminada', 'creadaEn',
                         'propias'])
          // Preguntas que escribió quien empieza: {"posición": {texto, opciones}}.
          && propiasOk(request.resource.data.get('propias', {}))
          && request.resource.data.juego in ['probable', 'adivina']
          && request.resource.data.preguntas is list
          && request.resource.data.preguntas.size() == 5
          && request.resource.data.por == me()
          && request.resource.data.respuestas.keys().hasOnly([me()])
          && cincoRespuestas(request.resource.data.respuestas[me()])
          && request.resource.data.terminada == false
          && request.resource.data.creadaEn == request.time;
        allow update: if isMember(coupleId) && (responde() || cobra());
        allow delete: if false;
      }

      // ---------- Juegos juntos: Dibuja y adivina ----------
      // dibujos/{ronda}: quien dibuja la crea con su palabra; los dos
      // escriben en el chat (mensajes); quien adivina la termina al acertar
      // (o se rinde); quien dibuja puede terminarla. Cada trazo es un
      // documento chiquito en dibujos/{ronda}/trazos/{n} que solo escribe
      // quien dibuja mientras la ronda sigue.
      match /dibujos/{rondaId} {
        function cambia() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
        function enJuego() {
          return resource.data.estado == 'dibujando';
        }
        function nuevoMensaje() {
          let antes = resource.data.mensajes;
          let ahora = request.resource.data.mensajes;
          let m = ahora[ahora.size() - 1];
          return ahora is list
            && ahora.size() == antes.size() + 1
            && ahora.size() <= 150
            && m.u == me()
            && m.t is string && m.t.size() > 0 && m.t.size() <= 60;
        }
        // Un mensaje del chat (de cualquiera de los dos).
        function chatea() {
          return enJuego()
            && cambia().hasOnly(['mensajes'])
            && nuevoMensaje()
            && request.resource.data.mensajes[request.resource.data.mensajes.size() - 1]
                 .get('a', false) == false;
        }
        // Quien adivina acierta: su mensaje termina la ronda.
        function adivina() {
          return enJuego()
            && resource.data.dibuja != me()
            && cambia().hasOnly(['mensajes', 'estado', 'acierto', 'adivinadaPor', 'terminadaEn'])
            && nuevoMensaje()
            && request.resource.data.estado == 'adivinada'
            && request.resource.data.acierto == resource.data.clave
            && request.resource.data.adivinadaPor == me()
            && request.resource.data.terminadaEn == request.time;
        }
        function termina() {
          return enJuego()
            && cambia().hasOnly(['estado', 'terminadaEn'])
            && request.resource.data.terminadaEn == request.time
            && request.resource.data.estado
                 == (resource.data.dibuja == me() ? 'cancelada' : 'rendida');
        }
        // "Borrar todo" de quien dibuja.
        function limpia() {
          return enJuego()
            && resource.data.dibuja == me()
            && cambia().hasOnly(['borradoHasta'])
            && request.resource.data.borradoHasta is int;
        }
        function mira() {
          return cambia().hasOnly(['viendo'])
            && request.resource.data.viendo.diff(resource.data.get('viendo', {}))
                 .affectedKeys().hasOnly([me()]);
        }
        function cobra() {
          let antes = resource.data.get('cobros', {});
          return resource.data.estado == 'adivinada'
            && (resource.data.dibuja == me() || resource.data.adivinadaPor == me())
            && !(me() in antes)
            && cambia().hasOnly(['cobros'])
            && request.resource.data.cobros.diff(antes).affectedKeys().hasOnly([me()])
            && request.resource.data.cobros[me()] is string;
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys()
               .hasOnly(['dibuja', 'palabra', 'clave', 'estado', 'mensajes', 'borradoHasta', 'creadaEn'])
          && request.resource.data.dibuja == me()
          && request.resource.data.palabra is string
          && request.resource.data.palabra.size() > 0
          && request.resource.data.palabra.size() <= 30
          && request.resource.data.clave is string
          && request.resource.data.clave.size() > 0
          && request.resource.data.clave.size() <= 30
          && request.resource.data.estado == 'dibujando'
          && request.resource.data.mensajes == []
          && request.resource.data.borradoHasta == 0
          && request.resource.data.creadaEn == request.time;
        allow update: if isMember(coupleId)
          && (chatea() || adivina() || termina() || limpia() || mira() || cobra());
        allow delete: if false;

        match /trazos/{trazoId} {
          function ronda() {
            return get(/databases/$(database)/documents/couples/$(coupleId)/dibujos/$(rondaId)).data;
          }
          function trazoValido() {
            let t = request.resource.data;
            return t.keys().hasOnly(['n', 'p', 'c', 'g', 'listo', 'por'])
              && t.por == me()
              && t.n is int && t.n >= 0 && t.n < 400
              && t.p is list && t.p.size() <= 600
              && t.c is int && t.g is int && t.g > 0 && t.g <= 60
              && t.listo is bool;
          }
          allow read: if isMember(coupleId);
          allow create, update, delete: if isMember(coupleId)
            && ronda().dibuja == me()
            && ronda().estado == 'dibujando'
            && (request.method == 'delete' || trazoValido());
        }
      }

      // ---------- Juegos juntos: fotos, memorama y rompecabezas ----------
      // fotosJuegos/{id}: fotos chiquitas (JPG en base64) que sube cada uno;
      // solo quien la subió la borra.
      match /fotosJuegos/{fotoId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys().hasOnly(['por', 'jpg', 'creadaEn'])
          && request.resource.data.por == me()
          && request.resource.data.jpg is string
          && request.resource.data.jpg.size() > 0
          && request.resource.data.jpg.size() <= 200000
          && request.resource.data.creadaEn == request.time;
        allow update: if false;
        allow delete: if isMember(coupleId) && resource.data.por == me();
      }

      function otroDe(uid) {
        let m = coupleDoc(coupleId).data.members;
        return m[0] == uid ? m[1] : m[0];
      }
      function cobraPartida() {
        let antes = resource.data.get('cobros', {});
        return resource.data.estado == 'terminada'
          && !(me() in antes)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cobros'])
          && request.resource.data.cobros.diff(antes).affectedKeys().hasOnly([me()])
          && request.resource.data.cobros[me()] is string;
      }

      // memoramas/{id}: 16 cartas; en tu turno abres dos. Después, si son
      // pareja se quedan con quien las encontró (y sigue); si no, le toca
      // al otro. Esa "resolución" la puede hacer cualquiera de los dos (por
      // si quien jugaba se fue).
      match /memoramas/{partidaId} {
        function cambia() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
        function abre() {
          let a = resource.data.abiertas;
          let b = request.resource.data.abiertas;
          let i = b[b.size() - 1];
          return resource.data.estado == 'jugando'
            && resource.data.turno == me()
            && cambia().hasOnly(['abiertas'])
            && a.size() < 2
            && b.size() == a.size() + 1
            && (a.size() == 0 || b[0] == a[0])
            && i is int && i >= 0 && i < 16
            && !(string(i) in resource.data.parejas)
            && !(i in a);
        }
        function resuelve() {
          let a = resource.data.abiertas;
          let d = request.resource.data;
          let pareja = resource.data.cartas[a[0]] == resource.data.cartas[a[1]];
          let total = resource.data.parejas.size() + 2;
          return resource.data.estado == 'jugando'
            && a.size() == 2
            && d.abiertas.size() == 0
            && (pareja
              ? (cambia().hasOnly(['abiertas', 'parejas', 'estado', 'terminadaEn'])
                && d.parejas.diff(resource.data.parejas).affectedKeys()
                     .hasOnly([string(a[0]), string(a[1])])
                && d.parejas[string(a[0])] == resource.data.turno
                && d.parejas[string(a[1])] == resource.data.turno
                && d.get('estado', 'jugando') == (total >= 16 ? 'terminada' : 'jugando'))
              : (cambia().hasOnly(['abiertas', 'turno'])
                && d.turno == otroDe(resource.data.turno)));
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys()
               .hasOnly(['por', 'cartas', 'turno', 'abiertas', 'parejas', 'estado', 'creadaEn'])
          && request.resource.data.por == me()
          && request.resource.data.turno == me()
          && request.resource.data.cartas is list
          && request.resource.data.cartas.size() == 16
          && request.resource.data.abiertas == []
          && request.resource.data.parejas == {}
          && request.resource.data.estado == 'jugando'
          && request.resource.data.creadaEn == request.time;
        allow update: if isMember(coupleId) && (abre() || resuelve() || cobraPartida());
        allow delete: if false;
      }

      // rompecabezas/{id}: las piezas mezcladas (orden); en tu turno
      // cambias dos de lugar. Si pones una en su sitio sigues tú.
      match /rompecabezas/{partidaId} {
        function mueve() {
          let d = request.resource.data;
          return resource.data.estado == 'jugando'
            && resource.data.turno == me()
            && d.diff(resource.data).affectedKeys()
                 .hasOnly(['orden', 'turno', 'movs', 'estado', 'terminadaEn'])
            && d.orden.size() == resource.data.orden.size()
            && d.orden.toSet() == resource.data.orden.toSet()
            && (d.turno == me() || d.turno == otroDe(me()))
            && d.movs == resource.data.movs + 1
            && d.estado in ['jugando', 'terminada'];
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys()
               .hasOnly(['por', 'foto', 'lado', 'orden', 'turno', 'movs', 'estado', 'creadaEn'])
          && request.resource.data.por == me()
          && request.resource.data.turno == me()
          && request.resource.data.lado in [3, 4, 5]
          && request.resource.data.orden is list
          && request.resource.data.orden.size() == request.resource.data.lado * request.resource.data.lado
          && request.resource.data.foto is string
          && request.resource.data.foto.size() <= 200
          && request.resource.data.movs == 0
          && request.resource.data.estado == 'jugando'
          && request.resource.data.creadaEn == request.time;
        allow update: if isMember(coupleId) && (mueve() || cobraPartida());
        allow delete: if false;
      }

      // ---------- Casita de los gatitos y pescaditos ----------
      // casita/estado: monedero compartido (pescaditos), lo que compraron
      // (tenemos), lo que está puesto (puestos) y la ropita (ropa).
      // casitaMovs/{id}: cada pescadito ganado o gastado. Se guardan juntos
      // en una transacción: el monedero solo cambia de número si en el mismo
      // momento se crea un movimiento nuevo (ultimoMov) por esa cantidad.
      function movPath(id) {
        return /databases/$(database)/documents/couples/$(coupleId)/casitaMovs/$(id);
      }
      function estadoPath() {
        return /databases/$(database)/documents/couples/$(coupleId)/casita/estado;
      }

      match /casita/{docId} {
        function antes(campo, porDefecto) {
          return resource == null ? porDefecto : resource.data.get(campo, porDefecto);
        }
        // Solo cambia lo que está puesto, la ropita o el tope de pomodoros.
        function soloDecora() {
          return request.resource.data.get('pescaditos', 0) == antes('pescaditos', 0)
            && request.resource.data.get('ultimoMov', null) == antes('ultimoMov', null)
            && request.resource.data.get('tenemos', []) == antes('tenemos', []);
        }
        // Llega un movimiento nuevo y el monedero cambia exactamente por él.
        function conMovimiento() {
          let id = request.resource.data.ultimoMov;
          return id is string
            && id != antes('ultimoMov', null)
            && !exists(movPath(id))
            && existsAfter(movPath(id))
            && request.resource.data.pescaditos is int
            && request.resource.data.pescaditos
                 == antes('pescaditos', 0) + getAfter(movPath(id)).data.cantidad
            && request.resource.data.pescaditos >= 0;
        }
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId)
          && docId == 'estado'
          && request.resource.data.keys()
               .hasOnly(['pescaditos', 'ultimoMov', 'tenemos', 'puestos', 'ropa', 'topes', 'foto',
                         'regalos', 'meta', 'propuesta', 'pushSentFor', 'bebes',
                         'sembrado', 'despensa', 'cocinado'])
          // Cuándo se sembró cada semilla: {cosa: milisegundos}.
          && request.resource.data.get('sembrado', {}) is map
          // Lo recogido del huerto ({tomate: 3}) y lo último que cocinaron
          // con eso ({receta, en}).
          && request.resource.data.get('despensa', {}) is map
          && request.resource.data.get('cocinado', {}) is map
          // Nombres de los gatitos bebés: {color: nombre}.
          && request.resource.data.get('bebes', {}) is map
          // Regalos sorpresa envueltos y la meta de la alcancía.
          && request.resource.data.get('regalos', {}) is map
          && request.resource.data.get('meta', '') is string
          // La foto pixelada del cuadro: 14 × 12 colores.
          && (!('foto' in request.resource.data)
              || (request.resource.data.foto is list
                  && request.resource.data.foto.size() == 168))
          && (soloDecora() || conMovimiento());
        allow delete: if false;
      }

      match /casitaMovs/{movId} {
        // Fecha yyyy-MM-dd de hace poco (para que no se cobren días viejos).
        function diaReciente(dia) {
          let p = dia.split('-');
          let t = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
          return dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && request.time > t - duration.value(2, 'd')
            && request.time < t + duration.value(2, 'd');
        }
        function logro(id) {
          return get(/databases/$(database)/documents/couples/$(coupleId)/achievements/$(id)).data;
        }
        function ganancia(d) {
          return (d.tipo == 'pregunta'
              && d.cantidad == 10
              && d.ref is string && d.ref.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && movId == 'pregunta_' + d.ref + '_' + me()
              && diaReciente(d.ref)
              && get(/databases/$(database)/documents/couples/$(coupleId)/dailyAnswers/$(d.ref))
                   .data.get('answers', {}).get(me(), null) is string)
            || (d.tipo == 'animo'
              && d.cantidad == 5
              && d.ref is string && d.ref.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && movId == 'animo_' + d.ref + '_' + me()
              && diaReciente(d.ref)
              && exists(/databases/$(database)/documents/couples/$(coupleId)/moods/$(me())))
            // Completar la respiración guiada: 8, una vez al día por persona.
            || (d.tipo == 'respira'
              && d.cantidad == 8
              && d.ref is string && d.ref.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && movId == 'respira_' + d.ref + '_' + me()
              && diaReciente(d.ref))
            // Juegos de pareja: 4 + 2 por coincidencia, en uno de los 3
            // lugares del día de cada persona, por una partida terminada
            // que todavía no había cobrado.
            || (d.tipo == 'juego'
              && d.ref is string && d.ref.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && d.slot is int && d.slot >= 1 && d.slot <= 3
              && movId == 'juego_' + d.ref + '_' + me() + '_' + string(d.slot)
              && diaReciente(d.ref)
              && d.partida is string
              && juegoCobrable(d))
            // Dibuja y adivina: 6 para quien dibujó y 6 para quien adivinó,
            // en uno de los 3 lugares del día de cada persona.
            || (d.tipo == 'dibujo'
              && d.cantidad == 6
              && d.ref is string && d.ref.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && d.slot is int && d.slot >= 1 && d.slot <= 3
              && movId == 'dibujo_' + d.ref + '_' + me() + '_' + string(d.slot)
              && diaReciente(d.ref)
              && d.ronda is string
              && dibujoCobrable(d))
            // Memorama y rompecabezas terminados: 8 a cada uno, 3 al día.
            || ((d.tipo == 'memorama' || d.tipo == 'rompe')
              && d.cantidad == 8
              && d.ref is string && d.ref.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && d.slot is int && d.slot >= 1 && d.slot <= 3
              && movId == d.tipo + '_' + d.ref + '_' + me() + '_' + string(d.slot)
              && diaReciente(d.ref)
              && d.partida is string
              && partidaCobrable(d))
            // Sudoku completado (se juega en el celular): según el nivel,
            // 3 al día.
            || (d.tipo == 'sudoku'
              && d.nivel in ['facil', 'medio', 'dificil', 'experto']
              && d.cantidad == {'facil': 5, 'medio': 8, 'dificil': 12, 'experto': 15}[d.nivel]
              && d.ref is string && d.ref.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && d.slot is int && d.slot >= 1 && d.slot <= 3
              && movId == 'sudoku_' + d.ref + '_' + me() + '_' + string(d.slot)
              && diaReciente(d.ref))
            || (d.tipo == 'pomodoro'
              && d.ref is string
              && movId == 'pomodoro_' + d.ref
              && logro(d.ref).uid == me()
              && logro(d.ref).kind == 'pomodoro'
              && d.cantidad == (logro(d.ref).get('sessionId', null) == null ? 10 : 15))
            || (d.tipo == 'racha'
              && d.meta is int && d.inicio is string
              && movId == 'racha' + string(d.meta) + '_' + d.inicio
              && exists(/databases/$(database)/documents/couples/$(coupleId)/achievements/$(movId + '_' + me()))
              && d.cantidad == (d.meta == 7 ? 50 : 150));
        }
        function partidaPath(id) {
          return /databases/$(database)/documents/couples/$(coupleId)/juegos/$(id);
        }
        // 1 si la respuesta i de los dos es la misma.
        function igual(a, b, i) {
          return a[i] == b[i] ? 1 : 0;
        }
        function juegoCobrable(d) {
          let antes = get(partidaPath(d.partida)).data;
          let despues = getAfter(partidaPath(d.partida)).data;
          let m = coupleDoc(coupleId).data.members;
          let a = antes.respuestas.get(m[0], []);
          let b = antes.respuestas.get(m[1], []);
          return antes.terminada == true
            && me() in antes.respuestas
            && !(me() in antes.get('cobros', {}))
            && despues.get('cobros', {}).get(me(), '') == movId
            && a.size() == 5 && b.size() == 5
            && d.cantidad == 4 + 2 * (igual(a, b, 0) + igual(a, b, 1) + igual(a, b, 2)
                                      + igual(a, b, 3) + igual(a, b, 4));
        }
        function partidaCobrable(d) {
          let col = d.tipo == 'memorama' ? 'memoramas' : 'rompecabezas';
          let path = /databases/$(database)/documents/couples/$(coupleId)/$(col)/$(d.partida);
          let antes = get(path).data;
          return antes.estado == 'terminada'
            && !(me() in antes.get('cobros', {}))
            && getAfter(path).data.get('cobros', {}).get(me(), '') == movId;
        }
        function dibujoCobrable(d) {
          let path = /databases/$(database)/documents/couples/$(coupleId)/dibujos/$(d.ronda);
          let antes = get(path).data;
          return antes.estado == 'adivinada'
            && (antes.dibuja == me() || antes.adivinadaPor == me())
            && !(me() in antes.get('cobros', {}))
            && getAfter(path).data.get('cobros', {}).get(me(), '') == movId;
        }
        function compra(d) {
          return d.tipo == 'compra'
            && d.ref is string
            && movId == 'compra_' + d.ref
            && d.cantidad is int && d.cantidad < 0
            // Cada uno compra lo que quiere; pedirle el sí a la pareja es
            // opcional (lo decide quien compra en la app).
            && d.ref in getAfter(estadoPath()).data.get('tenemos', []);
        }
        // Una carta sorpresa animada: 30 pescaditos por carta, y la carta
        // (de esta persona, marcada como sorpresa) se crea a la vez.
        function carta(d) {
          let c = getAfter(/databases/$(database)/documents/couples/$(coupleId)/letters/$(d.ref));
          return d.tipo == 'carta'
            && d.ref is string
            && movId == 'carta_' + d.ref
            && d.cantidad == -30
            && c.data.from == me()
            && c.data.get('sorpresa', false) == true;
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.uid == me()
          && request.resource.data.creadoEn == request.time
          && getAfter(estadoPath()).data.get('ultimoMov', null) == movId
          && (ganancia(request.resource.data) || compra(request.resource.data)
              || carta(request.resource.data));
        // Nadie los cambia ni los borra (el Worker marca el aviso con su
        // propia cuenta de servicio).
        allow update, delete: if false;
      }
    }
  }
}
