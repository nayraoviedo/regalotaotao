rules_version = '2';

// Reglas de seguridad de Taotao.
// Idea principal: todo lo de la pareja vive en couples/{coupleId} y solo
// las dos personas que están en `members` pueden leerlo o escribirlo.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }
    function coupleDoc(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId));
    }
    function coupleAfter(coupleId) {
      return getAfter(/databases/$(database)/documents/couples/$(coupleId));
    }
    function isMember(coupleId) {
      return signedIn() && me() in coupleDoc(coupleId).data.members;
    }
    // Una pareja desvinculada guarda sus recuerdos con `endedAt`.
    function ended(couple) { return couple.get('endedAt', null) != null; }
    function isPartnerOf(uid) {
      let myCouple = userDoc(me()).data.get('coupleId', null);
      return myCouple != null && uid in coupleDoc(myCouple).data.members;
    }

    // ---------- Perfiles ----------
    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || isPartnerOf(uid));

      allow create: if signedIn() && me() == uid
        && request.resource.data.coupleId == null;

      // La propia persona puede editar su perfil. Si cambia coupleId,
      // tiene que ser a null o a un espacio de pareja del que forma parte.
      allow update: if signedIn() && me() == uid
        && request.resource.data.pairCode == resource.data.pairCode
        && (
          request.resource.data.coupleId == resource.data.coupleId
          || request.resource.data.coupleId == null
          || uid in coupleAfter(request.resource.data.coupleId).data.members
        );

      // Vincularse: quien ingresa el código marca coupleId en el perfil de
      // la otra persona, solo si esa persona no tiene pareja todavía y en el
      // mismo batch se está creando el espacio de pareja con los dos.
      allow update: if signedIn() && me() != uid
        && resource.data.coupleId == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['coupleId'])
        && !exists(/databases/$(database)/documents/couples/$(request.resource.data.coupleId))
        && coupleAfter(request.resource.data.coupleId).data.members.hasAll([me(), uid]);

      // Volver a vincularse con la misma persona: se reabre el espacio de
      // pareja que tenían (con sus notas, cartas, etc.).
      allow update: if signedIn() && me() != uid
        && resource.data.coupleId == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['coupleId'])
        && ended(coupleDoc(request.resource.data.coupleId).data)
        && !ended(coupleAfter(request.resource.data.coupleId).data)
        && coupleAfter(request.resource.data.coupleId).data.members.hasAll([me(), uid]);

      // Desvincularse: quien termina la pareja también quita el coupleId de
      // la otra persona, en el mismo batch en que marca la pareja con endedAt.
      allow update: if signedIn() && me() != uid
        && resource.data.coupleId != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['coupleId'])
        && request.resource.data.coupleId == null
        && me() in coupleDoc(resource.data.coupleId).data.members
        && ended(coupleAfter(resource.data.coupleId).data);

      // Notas privadas: solo su dueño.
      match /privateNotes/{noteId} {
        allow read, write: if signedIn() && me() == uid;
      }

      // Tareas del pomodoro: solo su dueño.
      match /pomodoroTasks/{taskId} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    // ---------- Códigos de pareja ----------
    match /pairCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update, delete: if false;
    }

    // ---------- Espacio de pareja ----------
    match /couples/{coupleId} {
      allow read: if signedIn() && me() in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && getAfter(/databases/$(database)/documents/users/$(me())).data.coupleId == coupleId;

      // Mientras está activa, cualquiera de los dos la edita (también para
      // desvincularse, marcando endedAt). Ya desvinculada, solo se puede
      // reabrir, y quien la reabre vuelve a apuntar a ella en el mismo batch.
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.members == resource.data.members
        && (
          (!ended(resource.data)
            && (!ended(request.resource.data)
                || request.resource.data.endedBy == me()))
          || (!ended(request.resource.data)
            && getAfter(/databases/$(database)/documents/users/$(me())).data.coupleId == coupleId)
        );

      allow delete: if false;

      // Ánimo: cada uno escribe solo el suyo.
      match /moods/{uid} {
        allow read: if isMember(coupleId);
        allow write: if isMember(coupleId) && me() == uid;
      }

      // Notas compartidas: las leen los dos, cada uno edita las suyas.
      match /notes/{noteId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.authorId == me();
        allow update, delete: if isMember(coupleId)
          && resource.data.authorId == me();
        // Los dos pueden marcar o quitar los pendientes de una nota con lista.
        allow update: if isMember(coupleId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['items']);
      }

      // Cartas "Ábrelo cuando…": cada uno escribe para su pareja. Quien la
      // recibe solo puede marcarla como abierta; quien la escribió, borrarla.
      match /letters/{letterId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.from == me()
          && request.resource.data.to != me()
          && request.resource.data.to in coupleDoc(coupleId).data.members
          && request.resource.data.openedAt == null
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.cuando is string
          && request.resource.data.cuando.size() > 0
          && request.resource.data.cuando.size() <= 60;
        allow update: if isMember(coupleId)
          && me() == resource.data.to
          && resource.data.openedAt == null
          && request.resource.data.openedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['openedAt']);
        allow delete: if isMember(coupleId) && me() == resource.data.from;
      }

      // Pomodoro en pareja: uno invita, solo la otra persona puede aceptar.
      match /pomodoros/{sessionId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.invitedBy == me()
          && request.resource.data.invitee != me()
          && request.resource.data.invitee in coupleDoc(coupleId).data.members
          && request.resource.data.status == 'pending'
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 5
          && request.resource.data.minutes <= 60
          && request.resource.data.get('startedAt', null) == null;
        // Al aceptar, la persona invitada puede confirmar, bajar o subir la
        // duración. Después nadie puede cambiar la duración ni la hora de
        // inicio: de eso depende que la sesión juntos dé premio. Una sesión
        // cancelada (alguien se salió) o terminada ya no cambia más.
        allow update: if isMember(coupleId)
          && request.resource.data.invitedBy == resource.data.invitedBy
          && request.resource.data.invitee == resource.data.invitee
          && (
            (resource.data.status == 'pending'
              && me() == resource.data.invitee
              && request.resource.data.status == 'accepted'
              && request.resource.data.startedAt == request.time
              && request.resource.data.minutes is int
              && request.resource.data.minutes >= 5
              && request.resource.data.minutes <= 60)
            || (resource.data.status == 'pending'
              && me() == resource.data.invitee
              && request.resource.data.status == 'declined'
              && request.resource.data.minutes == resource.data.minutes
              && request.resource.data.get('startedAt', null) == null)
            || (request.resource.data.status == 'cancelled'
              && resource.data.status in ['pending', 'accepted']
              && request.resource.data.minutes == resource.data.minutes
              && request.resource.data.get('startedAt', null) == resource.data.get('startedAt', null))
            || (request.resource.data.status == 'finished'
              && resource.data.status == 'accepted'
              && request.resource.data.minutes == resource.data.minutes
              && request.resource.data.startedAt == resource.data.startedAt)
          );
      }

      // Premios: cada uno arma y edita su propia lista. En la app, la lista
      // de la pareja se muestra recién al terminar una sesión.
      match /rewards/{rewardId} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.createdBy == me()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80;
        allow update: if isMember(coupleId)
          && resource.data.createdBy == me()
          && request.resource.data.createdBy == me()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80;
        allow delete: if isMember(coupleId) && resource.data.createdBy == me();
      }

      // Logros (pomodoro o tarea cumplida) y el premio elegido.
      // Cada uno crea los suyos y elige su premio; la pareja solo puede
      // marcar que ya lo entregó. Solo se elige UN premio por logro: nace
      // sin premio, se elige una vez y después ya no se puede cambiar.
      match /achievements/{achievementId} {
        // Un pomodoro en pareja solo da logro si la sesión no se canceló
        // (nadie se salió) y ya pasó su tiempo completo.
        function sessionDone(sid) {
          let s = get(/databases/$(database)/documents/couples/$(coupleId)/pomodoros/$(sid)).data;
          return me() in [s.invitedBy, s.invitee]
            && s.status in ['accepted', 'finished']
            && s.startedAt is timestamp
            && request.time > s.startedAt + duration.value(s.minutes * 60 - 10, 's');
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.uid == me()
          && (request.resource.data.get('sessionId', null) == null
            || (request.resource.data.kind == 'pomodoro'
              && achievementId == request.resource.data.sessionId + '_' + me()
              && sessionDone(request.resource.data.sessionId)))
          && request.resource.data.kind in ['pomodoro', 'tarea', 'racha']
          // Premio de la racha: uno por meta (7, 30, 60…) y por racha.
          && (request.resource.data.kind != 'racha'
            || (request.resource.data.meta is int
              && (request.resource.data.meta == 7
                || (request.resource.data.meta > 0
                  && request.resource.data.meta % 30 == 0))
              && request.resource.data.inicio is string
              && request.resource.data.inicio.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && achievementId == 'racha' + string(request.resource.data.meta)
                   + '_' + request.resource.data.inicio + '_' + me()))
          && request.resource.data.delivered == false
          && request.resource.data.get('rewardId', null) == null
          && request.resource.data.get('rewardTitle', null) == null;
        allow update: if isMember(coupleId)
          && request.resource.data.uid == resource.data.uid
          && (
            // Elegir el premio: solo el dueño, solo si aún no tenía uno,
            // y tiene que ser un premio de la lista de la pareja.
            (me() == resource.data.uid
              && resource.data.delivered == false
              && resource.data.get('rewardId', null) == null
              && request.resource.data.rewardId is string
              && exists(/databases/$(database)/documents/couples/$(coupleId)/rewards/$(request.resource.data.rewardId))
              && request.resource.data.rewardTitle is string
              && request.resource.data.rewardTitle.size() > 0
              && request.resource.data.rewardTitle.size() <= 80
              && request.resource.data.rewardChosenAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['rewardId', 'rewardTitle', 'rewardChosenAt']))
            // Entregarlo: solo la pareja, y solo si ya hay premio elegido.
            || (me() != resource.data.uid
              && resource.data.get('rewardId', null) != null
              && request.resource.data.delivered == true
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['delivered']))
          );
        allow delete: if isMember(coupleId) && me() == resource.data.uid;
      }

      // Pregunta del día: cada uno solo escribe su propia respuesta.
      match /dailyAnswers/{day} {
        function previousAnswers() {
          return resource == null ? {} : resource.data.get('answers', {});
        }
        // Naipe que salió hoy: se elige una vez y ya no cambia.
        function previousCard() {
          return resource == null ? null : resource.data.get('carta', null);
        }
        function keepsCard() {
          return previousCard() == null
            || (request.resource.data.get('carta', null) == previousCard()
                && request.resource.data.get('question', null)
                     == resource.data.get('question', null));
        }
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId)
          && request.resource.data.get('answers', {}).diff(previousAnswers())
               .affectedKeys().hasOnly([me()])
          && keepsCard();
      }

      // Preguntas propias para el mazo de la pregunta del día. Cada uno
      // escribe, edita o borra las suyas; cualquiera de los dos la marca
      // como usada (una sola vez) el día que sale.
      match /preguntas/{preguntaId} {
        function textoValido(t) {
          return t is string && t.size() > 0 && t.size() <= 200;
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys()
               .hasOnly(['texto', 'autor', 'createdAt', 'usadaEn'])
          && request.resource.data.autor == me()
          && textoValido(request.resource.data.texto)
          && request.resource.data.get('usadaEn', null) == null;
        allow update: if isMember(coupleId)
          && resource.data.get('usadaEn', null) == null
          && (
            (resource.data.autor == me()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['texto'])
              && textoValido(request.resource.data.texto))
            || (request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['usadaEn'])
              && request.resource.data.usadaEn is string
              && request.resource.data.usadaEn
                   .matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          );
        allow delete: if isMember(coupleId) && resource.data.autor == me();
      }

      // Datos curiosos: cada uno escribe los suyos, los dos los leen.
      match /datosCuriosos/{datoId} {
        function datoValido(t) {
          return t is string && t.size() > 0 && t.size() <= 300;
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.keys()
               .hasOnly(['texto', 'autor', 'createdAt'])
          && request.resource.data.autor == me()
          && datoValido(request.resource.data.texto);
        allow update: if isMember(coupleId)
          && resource.data.autor == me()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['texto'])
          && datoValido(request.resource.data.texto);
        allow delete: if isMember(coupleId) && resource.data.autor == me();
      }

      // Racha de pareja: un doc por día con quién hizo su parte
      // ({hechos: {uid: true}}). Cada uno solo se marca a sí mismo.
      match /racha/{day} {
        function previousHechos() {
          return resource == null ? {} : resource.data.get('hechos', {});
        }
        allow read: if isMember(coupleId);
        allow create, update: if isMember(coupleId)
          && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['hechos'])
          && request.resource.data.hechos.diff(previousHechos())
               .affectedKeys().hasOnly([me()])
          && request.resource.data.hechos[me()] == true;
      }

      // Cosas por hacer juntos. Los dos agregan, marcan y borran; cuando ya
      // lo hicieron, cada uno deja solo su propia reseña.
      match /bucketList/{itemId} {
        function resenasBucketOk() {
          let antes = resource.data.get('resenas', {});
          let rs = request.resource.data.get('resenas', {});
          return !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['resenas'])
            || (rs is map
              && rs.diff(antes).affectedKeys().hasOnly([me()])
              && (!(me() in rs)
                || (rs[me()].keys().hasOnly(['estrellas', 'texto'])
                  && rs[me()].estrellas is int
                  && rs[me()].estrellas >= 1
                  && rs[me()].estrellas <= 5
                  && rs[me()].texto is string
                  && rs[me()].texto.size() <= 500)));
        }
        allow read, delete: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.get('resenas', {}).size() == 0;
        allow update: if isMember(coupleId) && resenasBucketOk();
      }

      // "Te extraño": la app le pide al Worker (worker/) que avise a la pareja.
      match /missYou/{id} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.from == me();
      }

      // Recomendación del día (canción, playlist, película, lugar…): cada uno
      // deja una por día para su pareja, con id {yyyy-MM-dd}_{uid}. Quien la
      // escribe la cambia o la borra; la pareja marca si le gustó, y los dos
      // pueden dejar su reseña (estrellitas y comentario), cada uno la suya.
      match /recomendaciones/{recId} {
        function recValida() {
          let r = request.resource.data;
          return r.keys().hasOnly(['from', 'dia', 'categoria', 'titulo',
                                   'nota', 'link', 'gusto', 'resenas',
                                   'updatedAt'])
            && r.from == me()
            && r.dia is string
            && r.dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && recId == r.dia + '_' + me()
            && r.categoria in ['playlist', 'cancion', 'pelicula', 'serie',
                               'libro', 'lugar', 'restaurante', 'podcast', 'otro']
            && r.titulo is string
            && r.titulo.size() > 0
            && r.titulo.size() <= 120
            && (r.get('nota', null) == null
              || (r.nota is string && r.nota.size() <= 300))
            && (r.get('link', null) == null
              || (r.link is string && r.link.size() <= 500
                  && r.link.matches('https?://.+')));
        }
        function previasResenas() {
          return resource.data.get('resenas', {});
        }
        function miResenaValida() {
          let rs = request.resource.data.get('resenas', {});
          return rs is map
            && rs.diff(previasResenas()).affectedKeys().hasOnly([me()])
            && (!(me() in rs)
              || (rs[me()].keys().hasOnly(['estrellas', 'texto'])
                && rs[me()].estrellas is int
                && rs[me()].estrellas >= 1
                && rs[me()].estrellas <= 5
                && rs[me()].texto is string
                && rs[me()].texto.size() <= 500));
        }
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && recValida()
          && request.resource.data.get('gusto', false) == false
          && request.resource.data.get('resenas', {}).size() == 0;
        // Quien la escribió cambia lo suyo, sin tocar corazón ni reseñas.
        allow update: if isMember(coupleId) && recValida()
          && request.resource.data.get('gusto', false)
               == resource.data.get('gusto', false)
          && request.resource.data.get('resenas', {}) == previasResenas();
        allow update: if isMember(coupleId)
          && resource.data.from != me()
          && request.resource.data.gusto is bool
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['gusto']);
        allow update: if isMember(coupleId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['resenas'])
          && miResenaValida();
        allow delete: if isMember(coupleId) && resource.data.from == me();
      }

      // Abrazos que se mandan desde el inicio cuando la pareja no está bien.
      match /abrazos/{id} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId)
          && request.resource.data.from == me();
      }
    }
  }
}
