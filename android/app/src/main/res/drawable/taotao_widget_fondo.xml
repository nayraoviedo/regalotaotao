<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget: tarjeta crema con borde azul marino y una costurita
     rosada por dentro, como un cuaderno kawaii. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/taotao_widget_crema" />
            <stroke android:width="2dp" android:color="@color/taotao_widget_azul" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="5dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/taotao_widget_costura"
                android:dashGap="3dp"
                android:dashWidth="5dp" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
