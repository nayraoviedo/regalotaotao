<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Días juntos y ánimo". Lo llena TaotaoWidget.kt con lo que guarda
     la app (lib/services/widget_celular/). Los dibujos (gatitos y ánimos) son
     PNG que exporta la app desde sus propios dibujos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/taotao_widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Izquierda: gatitos y días juntos -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_gatitos"
            android:layout_width="84dp"
            android:layout_height="38dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_dias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="casual"
            android:includeFontPadding="false"
            android:text="♡"
            android:textColor="@color/taotao_widget_azul"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_dias_texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="casual"
            android:gravity="center"
            android:text="días juntos"
            android:textColor="@color/taotao_widget_gris"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Separador punteado de corazones -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:gravity="center"
        android:lineSpacingMultiplier="0.9"
        android:text="·\n♥\n·"
        android:textColor="@color/taotao_widget_rosa"
        android:textSize="12sp" />

    <!-- Derecha: ánimo de tu pareja -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_animo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/taotao_widget_animo_fondo"
            android:importantForAccessibility="no"
            android:padding="3dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_pareja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="casual"
            android:gravity="center"
            android:maxLines="1"
            android:text="Tu pareja se siente"
            android:textColor="@color/taotao_widget_gris"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_animo_texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="casual"
            android:gravity="center"
            android:maxLines="2"
            android:text="Abre la app"
            android:textColor="@color/taotao_widget_azul"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
