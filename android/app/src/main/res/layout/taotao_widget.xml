<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Días juntos y ánimo", estilo kawaii: a la izquierda un
     calendarito con los dos gatitos asomándose, a la derecha cómo se siente
     tu pareja con una frase cariñosa. Lo llena TaotaoWidget.kt con lo que
     guarda la app (lib/services/widget_celular/).

     Dibujos reemplazables (PNG con fondo transparente):
     - Gatitos y ánimos: los exporta la app desde sus propios dibujos
       (assets/images/gatito_*.png y assets/moods/<id>.png).
     - Huellitas: res/drawable-nodpi/widget_huellita.png y widget_huellitas.png. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/taotao_widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Izquierda: calendarito de días juntos con los gatitos asomados -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="30dp"
            android:background="@drawable/taotao_widget_hoja"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:background="@drawable/taotao_widget_hoja_tapa" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_dias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="casual"
                    android:includeFontPadding="false"
                    android:text="♡"
                    android:textColor="@color/taotao_widget_azul"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_dias_texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="casual"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="días juntos ♡"
                    android:textColor="@color/taotao_widget_cafe"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Los dos gatitos asomándose por arriba del calendario -->
        <ImageView
            android:id="@+id/widget_gatitos"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="top|center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_huellitas" />
    </FrameLayout>

    <!-- Derecha: cómo se siente tu pareja -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1.15"
        android:background="@drawable/taotao_widget_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_pareja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/widget_huellita"
            android:drawablePadding="3dp"
            android:ellipsize="end"
            android:fontFamily="casual"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="Tu pareja se siente…"
            android:textColor="@color/taotao_widget_cafe"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_animo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/taotao_widget_animo_fondo"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_animo_texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/taotao_widget_pastilla"
                android:ellipsize="end"
                android:fontFamily="casual"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="Abre la app"
                android:textColor="@color/taotao_widget_azul"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_frase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="casual"
            android:gravity="center"
            android:maxLines="2"
            android:text="“Invita a tu pareja con tu código” ♡"
            android:textColor="@color/taotao_widget_azul"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
